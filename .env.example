# Shared environment
APP_ENV=development

# Next.js backend configuration
# Replace placeholders with the connection string from the team's Neon project.
# These values must remain server-side.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DB_NAME?sslmode=require&channel_binding=require
CORS_ORIGINS=http://localhost:3000
BACKEND_TEST_URL=http://127.0.0.1:3001
# Frontend server only: set in frontend/.env.local or the frontend process environment.
BACKEND_API_URL=http://127.0.0.1:3001/api/v1
# For HTTPS deployments behind a reverse proxy, configure the exact public origin.
# FRONTEND_ORIGIN=https://YOUR_FRONTEND_HOST

# Development sample accounts only. Replace every placeholder locally.
SEED_USER1_EMAIL=USER1_EMAIL_PLACEHOLDER
SEED_USER1_PASSWORD=USER1_PASSWORD_PLACEHOLDER
SEED_USER2_EMAIL=USER2_EMAIL_PLACEHOLDER
SEED_USER2_PASSWORD=USER2_PASSWORD_PLACEHOLDER
SEED_ADMIN_EMAIL=ADMIN_EMAIL_PLACEHOLDER
SEED_ADMIN_PASSWORD=ADMIN_PASSWORD_PLACEHOLDER
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8000

# Planned Python/FastAPI model-service configuration
MODEL_API_HOST=127.0.0.1
MODEL_API_PORT=8000

# The model service remains pending; backend setup is documented in backend/README.md.

# Data and model paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODEL_ARTIFACT_DIR=./ml/artifacts

